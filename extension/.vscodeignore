# The TS is bundled into dist/ by esbuild; the schema extractor is published
# into assets/schema-cli/ by `npm run build:schema-cli`. Ship both of those,
# nothing else. assets/ is intentionally NOT excluded here.
.github/**
.vscode/**
.vscode-test/**
.vscode-test.mjs
out/**
src/**
test/**
node_modules/**
**/*.ts
**/*.map
esbuild.mjs
eslint.config.mjs
vitest.config.ts
tsconfig.json
.gitignore
.eslintcache
assets/**/*.pdb
